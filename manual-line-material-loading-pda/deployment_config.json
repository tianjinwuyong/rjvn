    "auto_depanel": "mod_auto_depanel",
    "auto_case_binding": "mod_auto_case_binding",
    "auto_assembly_ate": "mod_auto_assembly_ate",
    "auto_supersonic": "mod_auto_supersonic",
    "auto_aging": "mod_auto_aging",
